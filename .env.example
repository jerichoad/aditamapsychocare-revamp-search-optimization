# Salin ke `.env.local` (tidak di-commit) lalu isi nilainya.
# Untuk deploy (Vercel/dll): isi variabel yang sama di dashboard hosting.

# ID container Google Tag Manager, format: GTM-XXXXXXX
# Kosong = GTM tidak dimuat sama sekali (build tetap hijau, tanpa request ke Google).
# Pakai container DEV/staging untuk preview agar data produksi tidak terkontaminasi.
NEXT_PUBLIC_GTM_ID=
